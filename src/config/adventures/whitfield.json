        "whitfield_corridor": {
            "name": "Concert Hall — Corridor",
            "kind": "dream",
            "background": "linear-gradient(180deg, #1a1530 0%, #080612 100%)",
            "description": "The corridor is narrow and quiet. Neither of you speaks for a long time. She walks. You walk. At the far end is a small room she could not leave. You do not go in. You stand at the door with her, and you do not flinch.",
            "onEnter": [
                {
                    "type": "narrate",
                    "kind": "system",
                    "text": "She shows you, as she has not shown anyone, what was said in that room. You do not perform on it. You witness it."
                },
                {
                    "type": "setFlag",
                    "flag": "walkedCorridor",
                    "value": true
                },
                {
                    "type": "narrate",
                    "speaker": "Wren",
                    "kind": "dialog",
                    "text": "(in your ear) The work is done. When you're ready."
                }
            ],
            "objects": [
                {
                    "id": "wf_speak",
                    "name": "Speak the phrase",
                    "x": 35,
                    "y": 75,
                    "display": {
