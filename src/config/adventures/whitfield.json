        "whitfield_wings": {
            "name": "Stage Left",
            "kind": "dream",
            "background": "linear-gradient(180deg, #1a0a0a 0%, #050202 100%)",
            "description": "The wings. Dust the colour of old velvet. The space behind the stage is deeper than the stage itself; the walls do not arrive where you would expect.",
            "objects": [
                {
                    "id": "wf_curtain",
                    "name": "The back curtain",
                    "x": 60,
                    "y": 28,
                    "display": {
                        "rect": {
