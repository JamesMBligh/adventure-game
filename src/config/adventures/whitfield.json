    "dialogs": {
        "whitfieldGreeting": {
            "id": "whitfieldGreeting",
            "start": "see",
            "nodes": {
                "see": {
                    "speaker": "Catherine",
                    "text": "You don't belong here. You have a face I half-remember.",
                    "choices": [
                        {
                            "text": "I'm here for the session.",
                            "next": "session"
                        },
                        {
                            "text": "Tell me about this place.",
                            "next": "place"
                        },
                        {
                            "text": "Who taught you to play?",
                            "next": "teacher",
                            "actions": [
                                {
                                    "type": "setFlag",
                                    "flag": "consideredTeacher",
                                    "value": true
                                }
                            ]
                        }
                    ]
                },
                "session": {
                    "speaker": "Catherine",
                    "text": "Session. — That word, in this hall. They are waiting on the other side of the curtain. They have always been waiting.",
                    "choices": [
                        {
                            "text": "Who taught you to play?",
                            "next": "teacher",
                            "actions": [
                                {
                                    "type": "setFlag",
                                    "flag": "consideredTeacher",
                                    "value": true
                                }
                            ]
                        },
                        {
                            "text": "I don't have to ask anything. I can stay.",
                            "next": "stay"
                        }
                    ]
                },
                "place": {
                    "speaker": "Catherine",
                    "text": "It is a hall the size of a railway station. The audience gathers without arriving. The keys will not let me down. — But the wings are deeper than the stage. You have noticed.",
                    "choices": [
                        {
                            "text": "Who taught you to play?",
                            "next": "teacher",
                            "actions": [
                                {
                                    "type": "setFlag",
                                    "flag": "consideredTeacher",
                                    "value": true
                                }
                            ]
                        },
                        {
                            "text": "I'm not here to make you play.",
                            "next": "stay"
                        }
                    ]
                },
                "stay": {
                    "speaker": "Catherine",
                    "text": "You're a stubborn one. — Most figures here ask me to perform. You haven't.",
                    "choices": [
                        {
                            "text": "Who taught you to play?",
                            "next": "teacher",
                            "actions": [
                                {
                                    "type": "setFlag",
                                    "flag": "consideredTeacher",
                                    "value": true
                                }
                            ]
                        }
                    ]
                },
                "teacher": {
                    "speaker": "Catherine",
                    "text": "… A man. He had a voice that carried over the keys. He knew where I was wrong before I did. — There is a corridor behind the curtain. I have not walked it. I don't know that I can.",
                    "choices": [
                        {
                            "text": "Then we'll walk it together.",
                            "actions": [
                                {
                                    "type": "narrate",
                                    "text": "She does not answer. She turns toward the back of the wings, and a corridor is suddenly there that was not there a moment ago.",
                                    "kind": "narration"
                                },
                                {
                                    "type": "showObject",
                                    "object": "wf_corridor_door"
                                },
                                {
                                    "type": "endDialog"
                                }
                            ]
                        }
                    ]
                }
            }
        },
        "whitfieldExit": {
            "id": "whitfieldExit",
            "start": "open",
            "nodes": {
                "open": {
                    "speaker": "Wren",
                    "text": "(in your ear) The work is done. The phrase, Ashley. Speak it.",
                    "choices": [
                        {
                            "text": "\"I should leave.\"",
                            "actions": [
                                {
                                    "type": "speakExitPhrase",
                                    "phrase": "I should leave",
                                    "expected": "the light in the conservatory",
                                    "wakeInteraction": "treatment_debrief",
                                    "onWrong": [
                                        {
                                            "type": "narrate",
                                            "speaker": "Wren",
                                            "kind": "dialog",
                                            "text": "Not that. The phrase we agreed on. Speak it."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "text": "\"Catherine, this is over.\"",
                            "actions": [
                                {
                                    "type": "speakExitPhrase",
                                    "phrase": "Catherine, this is over.",
                                    "expected": "the light in the conservatory",
                                    "wakeInteraction": "treatment_debrief",
                                    "onWrong": [
                                        {
                                            "type": "narrate",
                                            "speaker": "Wren",
                                            "kind": "dialog",
                                            "text": "She isn't the one who needs to hear that. The phrase. Speak it."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "text": "\"The light in the conservatory.\"",
                            "actions": [
                                {
                                    "type": "endDialog"
                                },
                                {
                                    "type": "speakExitPhrase",
                                    "phrase": "the light in the conservatory",
                                    "expected": "the light in the conservatory",
                                    "wakeInteraction": "treatment_debrief"
                                }
                            ]
                        }
                    ]
                }
            }
        }
    }
