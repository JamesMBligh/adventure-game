                    },
                    "menu": [
                        {
                            "label": "Examine",
                            "actions": [
                                {
                                    "type": "narrate",
                                    "text": "A heavy back curtain. Dust the colour of old velvet, holding still."
                                }
                            ]
                        },
                        {
                            "label": "Try to part it",
                            "actions": [
                                {
                                    "type": "narrate",
                                    "text": "The curtain holds. It does not so much resist your hand as decline to register it."
                                }
                            ]
                        }
