                                    },
                                    {
                                        "type": "setFlag",
                                        "flag": "debriefComplete",
                                        "value": true
                                    },
                                    {
                                        "type": "endDialog"
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": "study_empty",
            "location": "study",
            "background": "main/study/study-door.webp",
            "dialog": {
                "start": "open",
                "nodes": {
                    "open": {
                        "text": "Elias' study is empty. He is currently elsewhere.",
                        "nochoice": {
                            "actions": [
                                {
                                    "type": "wait"
                                },
