                                        "text": "Mrs. Whitfield will sleep through the afternoon. She will be brighter at supper than she has been in fifteen months."
                                    },
                                    {
                                        "type": "setFlag",
                                        "flag": "debriefComplete",
                                        "value": true
                                    },
                                    {
                                        "type": "endDialog"
                                    }
                                ]
                            }
                        ]
                    },
                    "bad": {
