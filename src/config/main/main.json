    "interactions": [
        {
            "id": "intro_sequence",
            "location": "driveway",
            "conditions": [
                {
                    "type": "not",
                    "condition": {
                        "type": "flag",
                        "flag": "introCompleted"
                    }
                }
            ],
            "background": "main/intro_sequence/front-view-day.webp",
            "animations": [],
            "onEnter": [
                {
                    "type": "narrate",
                    "kind": "system",
                    "text": "You return from a walk in the grounds of the Institute.  As you walked your thoughts turned to the things you have learned since being here, first as a patient and then as a member of staff."
                },
                {
                    "type": "narrate",
                    "kind": "system",
                    "text": "As you turn the corner of the drive you pause to take in the view of the Mansion.  This is exactly how it looked a year ago when you first arrived."
                },
                {
                    "type": "wait"
                }
            ],
            "dialog": {
                "start": "open",
                "nodes": {
                    "open": {
                        "kind": "system",
                        "text": "You think to yourself...",
                        "nochoice": {
                            "next": "step1"
                        }
                    },
                    "step1": {
                        "kind": "inner",
                        "text": "It never stops surprising me that I live here, let alone that I am apprentice to a disgraced academic with a cure for mental distress.",
                        "nochoice": {
                            "actions": [
                                {
                                    "type": "wait"
                                }
                            ],
                            "next": "step2"
                        }
                    },
                    "step2": {
                        "kind": "system",
                        "text": "You resume walking into the mansion to attend your next meeting with Dr Elias Wren. Your mentor and the owner of the estate.",
                        "nochoice": {
                            "actions": [
                                {
                                    "type": "setInteractionVisuals",
                                    "background": "main/intro_sequence/front-view-close-day.webp",
                                    "animations": [
                                        "rain"
                                    ]
                                },
                                {
                                    "type": "pause",
                                    "seconds": 1.5
                                }
                            ],
                            "next": "step3"
                        }
                    },
                    "step3": {
                        "kind": "system",
                        "text": "As you walk a light rain begins to fall.  You quicken your steps.",
                        "nochoice": {
                            "next": "step4"
                        }
                    },
                    "step4": {
                        "kind": "inner",
                        "text": "I really need to get inside and stop putting this off. I know why Elias wants to meet with me. I can't believe I'm so nervous.",
                        "nochoice": {
                            "actions": [
                                {
                                    "type": "wait"
                                },
                                {
                                    "type": "setInteractionVisuals",
                                    "background": "main/intro_sequence/entryway.webp",
                                    "animations": null
                                }
                            ],
                            "next": "close"
                        }
                    },
                    "close": {
                        "kind": "system",
                        "text": "You pause briefly before the door.  Once you feel composed you head inside.",
                        "onEnter": [],
                        "nochoice": {
                            "actions": [
                                {
                                    "type": "wait"
                                },
                                {
                                    "type": "setFlag",
                                    "flag": "introCompleted",
                                    "value": true
                                },
                                {
                                    "type": "gotoSite",
                                    "site": "mansion_first_floor"
                                },
                                {
                                    "type": "endDialog"
                                },
                                {
                                    "type": "narrate",
                                    "kind": "system",
                                    "text": "— You enter the mansion —\nThis is a map of the first floor of the Wren Institute.  Locations that can be visited are marked by an icon. New locations will become available as you progress."
                                }
                            ]
                        }
                    }
                }
            }
        },
        {
            "id": "intro_dialog",
            "location": "study",
            "highlight": true,
            "conditions": [
                {
                    "type": "not",
                    "condition": {
                        "type": "flag",
                        "flag": "introDialogComplete"
                    }
                }
            ],
            "background": "main/study/study-door.webp",
            "overlays": [
                {
                    "id": "elias_standing",
                    "image": "main/study/elias-at-window.png",
                    "place": {
                        "top": 15,
                        "left": 57,
                        "scale": 21.4
                    },
                    "transition": "fade"
                }
            ],
            "onEnter": [
                {
                    "type": "narrate",
                    "kind": "system",
                    "text": "You enter Elias' study. He is standing by the window looking out thoughtfully."
                },
                {
                    "type": "wait"
                }
            ],
            "dialog": {
                "start": "open",
                "nodes": {
                    "open": {
                        "speaker": "Elias",
                        "text": "You're back from your walk.  I noticed it rained briefly.  I hope you weren't caught out.",
                        "choices": [
                            {
                                "text": "Only a little. I was too lost in my thoughts to notice.",
                                "next": "step1",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "text": "He glances at you with concern and then returns his gaze to the window."
                                    }
                                ]
                            },
                            {
                                "text": "No. Not at all.",
                                "next": "step1",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "text": "He nods slightly."
                                    }
                                ]
                            }
                        ]
                    },
                    "step1": {
                        "speaker": "Elias",
                        "text": "I think it's time Ashley.  I think you are ready to operate solo for the first time.",
                        "nochoice": {
                            "actions": [
                                {
                                    "type": "narrate",
                                    "text": "Elias walks over and sits at his desk."
                                },
                                {
                                    "type": "setInteractionVisuals",
                                    "removeOverlay": "elias_standing"
                                },
                                {
                                    "type": "setInteractionVisuals",
                                    "addOverlay": {
                                        "id": "elias_sitting",
                                        "image": "main/study/elias-seated.png",
                                        "place": {
                                            "top": 26.2,
                                            "left": 43.8,
                                            "scale": 16
                                        },
                                        "transition": "fade"
                                    }
                                },
                                {
                                    "type": "pause",
                                    "seconds": 1.5
                                }
                            ],
                            "next": "step2"
                        }
                    },
                    "step2": {
                        "speaker": "Elias",
                        "text": "How do feel about going solo?  Are you ready?",
                        "choices": [
                            {
                                "text": "I think so, but I'm still nervous. It's a big responsibility.",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "kind": "dialog",
                                        "speaker": "Elias",
                                        "text": "Fair enough.  Let's go over everything one more time."
                                    },
                                    {
                                        "type": "pause",
                                        "seconds": 1
                                    }
                                ],
                                "next": "step3"
                            },
                            {
                                "text": "Absolutely.  I feel prepared and excited to take the next step.",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "text": "Elias chuckles."
                                    },
                                    {
                                        "type": "narrate",
                                        "kind": "dialog",
                                        "speaker": "Elias",
                                        "text": "I love your confidence. Just to make sure, however, Let's go over everything one more time."
                                    },
                                    {
                                        "type": "pause",
                                        "seconds": 1
                                    }
                                ],
                                "next": "step3"
                            }
                        ]
                    },
                    "step3": {
                        "speaker": "Elias",
                        "text": "I will bring the patient in and get her settled. I will then administer sedation and initiate a hypnotic trance. While I do this you will prepare yourself in the operator chair in the device room.",
                        "nochoice": {
                            "actions": [
                                {
                                    "type": "wait"
                                },
                                {
                                    "type": "narrate",
                                    "kind": "dialog",
                                    "speaker": "Elias",
                                    "text": "I will monitor the patient until I detect a strong delta wave with gamma spikes indicating active REM sleep. Once she has reached this state I will initiate the dream walk.  Then it's up to you."
                                },
                                {
                                    "type": "wait"
                                }
                            ],
                            "next": "questions"
                        }
                    },
                    "questions": {
                        "speaker": "Elias",
                        "text": "Any other questions?",
                        "onEnter": [
                            {
                                "type": "wait"
                            }
                        ],
                        "choices": [
                            {
                                "text": "Once I'm in the dream how do I know what to do to help the patient?",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "kind": "dialog",
                                        "speaker": "Elias",
                                        "text": "Ah, this is always the biggest challenge. The answer is that you really don't. You need to understand the patient and the dream itself to figure that out. Reading the case file and spending the time to explore the dream are the only real ways to determine what will ultimately help the patient."
                                    },
                                    {
                                        "type": "pause",
                                        "seconds": 1
                                    }
                                ],
                                "next": "questions"
                            },
                            {
                                "text": "Can I be harmed inside the dream?",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "kind": "dialog",
                                        "speaker": "Elias",
                                        "text": "No, there is no psychological risk to the operator. It is draining, however, and we don't know what happens if you reach the point of exhaustion while still dream walking. Avoid that outcome."
                                    },
                                    {
                                        "type": "narrate",
                                        "kind": "dialog",
                                        "speaker": "Elias",
                                        "text": "Unfortunately the patient is not so safe.  Just as a dream walk can provide amazing benefit, if done poorly it can be psychologically harmful and make matters work.  You must be careful."
                                    },
                                    {
                                        "type": "pause",
                                        "seconds": 1
                                    }
                                ],
                                "next": "questions"
                            },
                            {
                                "text": "How do I leave the dream?",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "kind": "dialog",
                                        "speaker": "Elias",
                                        "text": "The best way to exit the dream is to resolve the remaining issues that trouble the patient. Once this happens the patient usually falls into a deep sleep and the dream naturally ends. You can leave the dream at any time however.  I will be monitoring and you only need to signal me."
                                    },
                                    {
                                        "type": "pause",
                                        "seconds": 1
                                    }
                                ],
                                "next": "questions"
                            },
                            {
                                "text": "Does the patient know what I'll be doing?",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "text": "Elias looks annoyed with you."
                                    },
                                    {
                                        "type": "narrate",
                                        "kind": "dialog",
                                        "speaker": "Elias",
                                        "text": "I am not going to enter into this debate again. My policy is that the patients are to believe their relief comes from hypnotherapy only. I do not wish the existence of the device to be widely known. I'm surprised you would even bring this up again."
                                    },
                                    {
                                        "type": "pause",
                                        "seconds": 1
                                    }
                                ],
                                "next": "questions"
                            },
                            {
                                "text": "No. I'm ready.",
                                "next": "close"
                            }
                        ]
                    },
                    "close": {
                        "speaker": "Elias",
                        "text": "Very well then. Head to the device room while I prepare Mrs Whitfield. I will signal you when she is ready. You should use the intervening time to review the case file.",
                        "nochoice": {
                            "actions": [
                                {
                                    "type": "narrate",
                                    "text": "Elias hands you the case file for Mrs Whitfield"
                                },
                                {
                                    "type": "setFlag",
                                    "flag": "introDialogComplete",
                                    "value": true
                                },
                                {
                                    "type": "setPatientStatus",
                                    "patient": "whitfield",
                                    "status": "inResidence"
                                },
                                {
                                    "type": "endDialog"
                                },
                                {
                                    "type": "narrate",
                                    "kind": "system",
                                    "text": "— You rise and leave the study —"
                                },
                                {
                                    "type": "narrate",
                                    "kind": "system",
                                    "text": "You can now access your case files by clicking the button in the title bar"
                                }
                            ]
                        }
                    }
                }
            }
        },
        {
            "id": "whitfield_session",
            "location": "treatment_room",
            "conditions": [
                {
                    "type": "and",
                    "conditions": [
                        {
                            "type": "not",
                            "condition": {
                                "type": "flag",
                                "flag": "sessionCompleted"
                            }
                        },
                        {
                            "type": "flag",
                            "flag": "introDialogComplete"
                        }
                    ]
                }
            ],
            "background": "main/treatment/treatment-room.webp",
            "onEnter": [
                {
                    "type": "narrate",
                    "kind": "system",
                    "text": "You enter the treatment room to prepare for your first time as solo operator."
                }
            ],
            "dialog": {
                "start": "open",
                "nodes": {
                    "open": {
                        "type": "narrate",
                        "text": "The treatment room is clinical but functional.  It is certainly a non-standard room for providing psychological therapy. But the therapy provided in this room is also non-standard.\n\nThe treatment room contains the therapy chair and the control rig.  There is also a door through to the device room.",
                        "choices": [
                            {
                                "text": "Examine the chair.",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "text": "The chair is comfortable but functional.  It is designed to keep the patient safe from cramps or blood clots during long periods of deep sleep."
                                    }
                                ]
                            },
                            {
                                "text": "Examine the control rig.",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "text": "The control rig is a critical component of the device and I have been instructed in its use. But, despite many hours of operation, I have no idea how it works.\n\nElias has told me that the headset, that is placed over the patient's head, manipulates brain waves during sleep but beyond that it is a mystery to me."
                                    }
                                ]
                            },
                            {
                                "text": "Step into the device room.",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "kind": "system",
                                        "text": "— You open the door and step into the device room —"
                                    },
                                    {
                                        "type": "setInteractionVisuals",
                                        "background": "main/treatment/device-room.webp"
                                    },
                                    {
                                        "type": "pause",
                                        "seconds": 1.5
                                    }
                                ],
                                "next": "step1"
                            }
                        ]
                    },
                    "step1": {
                        "type": "narrate",
                        "text": "The device room has a very different feel. Patients are not expected to enter this room.  As a result, the room is bare, functional and no nonsense.\n\nThere are two chairs, with their device connected headsets, here.  The first chair is for the operator and the second for an observer.",
                        "nochoice": {
                            "actions": [
                                {
                                    "type": "narrate",
                                    "text": "My next step is to ready myself in the operator chair and wait for Elias to let me know that patient, Mrs Whitfield, is prepared."
                                },
                                {
                                    "type": "pause",
                                    "seconds": 1.5
                                }
                            ],
                            "next": "step2"
                        }
                    },
                    "step2": {
                        "type": "narrate",
                        "text": "This is my last chance to review the case file before I begin the session.",
                        "choices": [
                            {
                                "text": "I'm ready.  Sit in the operator chair.",
                                "actions": [
                                    {
                                        "type": "narrate",
                                        "kind": "system",
                                        "text": "You sit. You hear activity in the treatment room as Dr Wren and Mrs Whitfield enter. Eventually, Elias' voice sounds in your headset."
                                    },
                                    {
                                        "type": "narrate",
                                        "speaker": "Elias",
                                        "kind": "dialog",
                                        "text": "Alright Ashley.  Let's begin."
                                    },
                                    {
                                        "type": "wait"
                                    },
                                    {
                                        "type": "setFlag",
                                        "flag": "sessionCompleted",
                                        "value": true
                                    },
                                    {
                                        "type": "endDialog"
                                    },
                                    {
                                        "type": "enterDream",
                                        "patient": "whitfield"
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        },
