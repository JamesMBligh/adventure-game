                        "choices": [
                            {
                                "text": "I understand.",
                                "actions": [
                                    {
                                        "type": "setPatientStatus",
                                        "patient": "whitfield",
                                        "status": "unhelped"
                                    },
                                    {
                                        "type": "recordPatientNote",
